{
  "name": "@bangle.dev/banger-editor-root",
  "version": "1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "manypkg": {
    "defaultBranch": "main",
    "workspaceProtocol": "allow"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "scripts": {
    "lint": "pnpm biome check",
    "lint:ci": "pnpm run typecheck && pnpm biome ci .  --diagnostic-level=error",
    "lint:fix": "pnpm biome check --fix",
    "test:ci": "pnpm vitest run",
    "typecheck": "tsc -b",
    "publish-alpha": "pnpm -r --filter \"./packages/**\"  publish --tag alpha --otp ${npm_config_otp} --access public --no-git-checks"
  }
}
